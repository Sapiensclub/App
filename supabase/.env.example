# Sapiens — SERVER-SIDE secrets (Edge Functions, scripts). Copy to .env.local.
# These are real secrets: never in git, never in the app, never printed.
#
# When Edge Functions arrive (Phase 2+), these get pushed to the platform with:
#   npx supabase secrets set --env-file supabase/.env.local
# (Deployed functions automatically receive SUPABASE_URL and the service key
#  from the platform itself — the entries here cover everything extra.)

# ── Needed from Phase 2 (dispatch engine + push) ─────────────────────────────
# expo.dev → Account settings → Access tokens → create one
EXPO_ACCESS_TOKEN=

# ── Later (leave blank for now) ──────────────────────────────────────────────
# Real KYC vendor key — Phase 1 uses a stub; fill when the vendor is chosen
KYC_PROVIDER_KEY=

# SMS provider key (MSG91 / SmartPing / Twilio) — phone OTP + SOS SMS
SMS_PROVIDER_KEY=

# DLT-registered SMS template ids (comma-separated), once DLT registration is done
SMS_DLT_TEMPLATE_IDS=
