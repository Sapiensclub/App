# ── Secrets — never commit these ──────────────────────────────
# Every .env file in every sub-project is ignored.
# Committed *.env.example files document which keys are needed.
**/.env
**/.env.*
!**/.env.example

# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output & caches ─────────────────────────────────────
**/.expo/
**/dist/
**/web-build/
**/.next/
**/out/
**/*.tsbuildinfo
**/.turbo/

# ── Native build folders (generated by Expo prebuild if ever used)
**/ios/
**/android/

# ── OS / editor noise ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# ── Supabase local dev ────────────────────────────────────────
supabase/.temp/
supabase/.branches/
