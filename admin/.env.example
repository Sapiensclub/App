# Sapiens admin dashboard — environment variables.
# Copy this file to .env.local and fill in real values (never commit .env.local).

# Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard → Project Settings → API Keys → "publishable" key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase "secret" key (sb_secret_...) — SERVER ONLY. Bypasses Row Level
# Security. Used by admin server code in Phase 7. Never expose to a browser,
# never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_KEY=
