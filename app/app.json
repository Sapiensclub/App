{
  "expo": {
    "name": "Sapiens",
    "slug": "sapiens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sapiens",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.sapiens.app"
    },
    "android": {
      "package": "club.sapiens.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EC",
          "dark": {
            "backgroundColor": "#0D0B1A"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sapiens uses your photos so you can set a display photo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sapiens uses your location to find help near you and to let nearby people find your request. Your exact location is never shown to others until you confirm a helper."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F59E2D"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sapiens uses your microphone so you can send voice notes in chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4347e3a-9316-451b-b879-85886be54a82"
      }
    },
    "owner": "sapiensclub",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d4347e3a-9316-451b-b879-85886be54a82"
    }
  }
}
