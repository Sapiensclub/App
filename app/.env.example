# Sapiens mobile app — environment variables.
# Copy this file to .env.local and fill in real values (never commit .env.local).
#
# EXPO_PUBLIC_* variables are bundled into the app and safe to expose to clients.
# NEVER put a secret/service key in this file or in the app.

# ── Supabase (needed from Chunk C) ───────────────────────────────────────────
# Dashboard → Project Settings → API → Project URL (https://xxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Dashboard → Project Settings → API Keys → "publishable" key (sb_publishable_...)
# (If your project shows the older key style instead, use the "anon public" key here.)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── PostHog (needed from Chunk E) ────────────────────────────────────────────
# PostHog → Settings → Project → Project API Key (phc_...)
EXPO_PUBLIC_POSTHOG_KEY=

# Your PostHog region's host:
#   US cloud → https://us.i.posthog.com
#   EU cloud → https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
