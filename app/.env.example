# Sapiens mobile app — environment variables.
# Copy this file to .env.local and fill in real values (never commit .env.local).
#
# EXPO_PUBLIC_* variables are bundled into the app and safe to expose to clients.
# NEVER put a secret/service key in this file or in the app.

# Supabase dashboard → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase dashboard → Project Settings → API Keys → "publishable" key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog project → Settings → Project API key (phc_...)
EXPO_PUBLIC_POSTHOG_KEY=
